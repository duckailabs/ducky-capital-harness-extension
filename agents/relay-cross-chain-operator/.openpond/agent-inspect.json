  "project": {
    "name": "relay-cross-chain-operator",
    "version": "0.1.0",
    "useCase": "relay-cross-chain-routing-and-guarded-broadcast",
    "description": "Quote Relay routes, review each cross-chain step, broadcast exact signed EVM steps, and monitor destination completion."
  },
  "agent": {
    "id": "relay-cross-chain-operator",
    "defaultAction": "chat",
    "manifestHash": "5e97f4ebf3207d7ef2a5e1c50c2dcba49b6226f0c956949ea6cb463764c26138"
  },
  "actionCatalog": [
    {
      "id": "chat",
      "name": "chat",
      "label": "Chat",
      "description": "Explain the Relay Cross-Chain Operator's explicit actions.",
      "visibility": "default",
      "implementation": {
        "type": "intent-router",
        "routerId": "chat-router"
      },
      "inputSchema": null,
      "outputSchema": null,
      "approvalPolicy": {
        "mode": "never",
        "reason": "Read-only action discovery."
      },
      "artifactPolicy": {
        "outputArtifacts": [],
        "persistRunSummary": true,
        "persistTrace": true
      },
      "setupRequirements": [],
      "mcp": {
        "enabled": false
      },
      "schedulePolicy": {
        "enabled": false,
        "allowAdHoc": true
      },
      "trace": {
        "name": "chat",
        "namespace": "actions"
      },
      "invokesModel": true
    },
    {
      "id": "quote-relay-transfer",
      "name": "quote-relay-transfer",
      "label": "Quote Relay Transfer",
      "description": "Request an unsigned exact-input EVM cross-chain quote through the Relay SDK.",
      "visibility": "end_user",
      "implementation": {
        "type": "workflow",
        "workflowId": "quote-relay-transfer"
      },
      "inputSchema": "RelayQuoteInput",
      "outputSchema": null,
      "approvalPolicy": {
        "mode": "never",
        "reason": "Read-only quote request without a wallet."
      },
      "artifactPolicy": {
        "outputArtifacts": [
          "artifacts/relay-quote.json"
        ],
        "persistRunSummary": true,
        "persistTrace": true
      },
      "setupRequirements": [],
      "mcp": {
        "enabled": false
      },
      "schedulePolicy": {
        "enabled": false,
        "allowAdHoc": true
      },
      "trace": {
        "name": "quote-relay-transfer",
        "namespace": "actions"
      },
      "invokesModel": false
    },
    {
      "id": "review-relay-quote",
      "name": "review-relay-quote",
      "label": "Review Relay Quote",
      "description": "Verify and summarize a quote's hash, fees, steps, request IDs, and expiry.",
      "visibility": "end_user",
      "implementation": {
        "type": "workflow",
        "workflowId": "review-relay-quote"
      },
      "inputSchema": "RelayReviewInput",
      "outputSchema": null,
      "approvalPolicy": {
        "mode": "never",
        "reason": "Pure validation of a supplied quote artifact."
      },
      "artifactPolicy": {
        "outputArtifacts": [
          "artifacts/relay-quote-review.json"
        ],
        "persistRunSummary": true,
        "persistTrace": true
      },
      "setupRequirements": [],
      "mcp": {
        "enabled": false
      },
      "schedulePolicy": {
        "enabled": false,
        "allowAdHoc": true
      },
      "trace": {
        "name": "review-relay-quote",
        "namespace": "actions"
      },
      "invokesModel": false
    },
    {
      "id": "relay-transfer-status",
      "name": "relay-transfer-status",
      "label": "Relay Transfer Status",
      "description": "Read cross-chain lifecycle state from Relay's status endpoint.",
      "visibility": "end_user",
      "implementation": {
        "type": "workflow",
        "workflowId": "relay-transfer-status"
      },
      "inputSchema": "RelayStatusInput",
      "outputSchema": null,
      "approvalPolicy": {
        "mode": "never",
        "reason": "Read-only Relay API request."
      },
      "artifactPolicy": {
        "outputArtifacts": [
          "artifacts/relay-status.json"
        ],
        "persistRunSummary": true,
        "persistTrace": true
      },
      "setupRequirements": [],
      "mcp": {
        "enabled": false
      },
      "schedulePolicy": {
        "enabled": false,
        "allowAdHoc": true
      },
      "trace": {
        "name": "relay-transfer-status",
        "namespace": "actions"
      },
      "invokesModel": false
    },
    {
      "id": "broadcast-relay-step",
      "name": "broadcast-relay-step",
      "label": "Broadcast Relay Step",
      "description": "Verify, simulate, and broadcast one externally signed exact-match Relay transaction step.",
      "visibility": "end_user",
      "implementation": {
        "type": "workflow",
        "workflowId": "broadcast-relay-step"
      },
      "inputSchema": "RelayBroadcastInput",
      "outputSchema": null,
      "approvalPolicy": {
        "mode": "always",
        "reason": "Broadcasts a signed onchain transaction."
      },
      "artifactPolicy": {
        "outputArtifacts": [
          "artifacts/relay-step-receipt.json"
        ],
        "persistRunSummary": true,
        "persistTrace": true
      },
      "setupRequirements": [],
      "mcp": {
        "enabled": false
      },
      "schedulePolicy": {
        "enabled": false,
        "allowAdHoc": false
      },
      "trace": {
        "name": "broadcast-relay-step",
        "namespace": "actions"
      },
      "invokesModel": false
    }
  ],
